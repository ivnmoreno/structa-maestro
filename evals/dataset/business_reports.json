    {
      "case_id": "rpt-pdf-001",
      "category": "business_reports",
      "format": "pdf",
      "challenge_profiles": [
        "straightforward"
      ],
      "description": "Straightforward PDF quarterly business performance report.",
      "document": {
        "kind": "pdf",
        "filename": "rpt_001.pdf",
        "pages": [
          "company_name: Borealis Grid Inc.\nreporting_period: 2026-Q1\nrevenue_millions: 48.20\noperating_margin: 14.5\nheadcount: 320"
        ]
      },
      "schema_definition": {
        "schema_id": "business-report-schema",
        "schema_version": "1.0",
        "cardinality": "single",
        "fields": {
          "company_name": {
            "type": "string",
            "required": true
          },
          "reporting_period": {
            "type": "string",
            "required": true
          },
          "revenue_millions": {
            "type": "decimal",
            "required": true,
            "min_value": 0
          },
          "operating_margin": {
            "type": "decimal",
            "required": true
          },
          "headcount": {
            "type": "integer",
            "required": true,
            "min_value": 1
          },
          "guidance_notes": {
            "type": "string",
            "required": false,
            "nullable": true
          }
        }
      },
      "expected_status": "completed",
      "expected_validation": "valid",
      "expected_records": [
        {
          "expected_validation": "valid",
          "fields": {
            "company_name": {
              "presence": "present",
              "value": "Borealis Grid Inc.",
              "match_mode": "exact",
              "expected_evidence": [
                "company_name: Borealis Grid Inc."
              ],
              "expect_ambiguous": false
            },
            "reporting_period": {
              "presence": "present",
              "value": "2026-Q1",
              "match_mode": "exact",
              "expected_evidence": [
                "reporting_period: 2026-Q1"
              ],
              "expect_ambiguous": false
            },
            "revenue_millions": {
              "presence": "present",
              "value": "48.20",
              "match_mode": "decimal_equal",
              "expected_evidence": [
                "revenue_millions: 48.20"
              ],
              "expect_ambiguous": false
            },
            "operating_margin": {
              "presence": "present",
              "value": "14.5",
              "match_mode": "decimal_equal",
              "expected_evidence": [
                "operating_margin: 14.5"
              ],
              "expect_ambiguous": false
            },
            "headcount": {
              "presence": "present",
              "value": 320,
              "match_mode": "exact",
              "expected_evidence": [
                "headcount: 320"
              ],
              "expect_ambiguous": false
            },
            "guidance_notes": {
              "presence": "missing",
              "value": null,
              "match_mode": "exact",
              "expected_evidence": [],
              "expect_ambiguous": false
            }
          }
        }
      ]
