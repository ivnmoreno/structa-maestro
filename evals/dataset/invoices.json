{
  "cases": [
    {
      "case_id": "inv-txt-001",
      "category": "invoices",
      "format": "txt",
      "challenge_profiles": [
        "straightforward"
      ],
      "description": "Straightforward TXT invoice with optional notes absent.",
      "document": {
        "kind": "txt",
        "filename": "inv_001.txt",
        "lines": [
          "invoice_number: INV-2026-101",
          "vendor_name: Northwind Industrial Ltd.",
          "issue_date: 2026-04-01",
          "total_amount: 2450.00",
          "currency: USD"
        ]
      },
      "schema_definition": {
        "schema_id": "invoice-schema",
        "schema_version": "1.0",
        "cardinality": "single",
        "fields": {
          "invoice_number": {
            "type": "string",
            "required": true,
            "pattern": "^INV-\\d{4}-\\d{3,}$"
          },
          "vendor_name": {
            "type": "string",
            "required": true
          },
          "issue_date": {
            "type": "date",
            "required": true
          },
          "total_amount": {
            "type": "decimal",
            "required": true,
            "min_value": 0
          },
          "currency": {
            "type": "string",
            "required": true,
            "allowed_values": [
              "USD",
              "EUR",
              "GBP"
            ]
          },
          "notes": {
            "type": "string",
            "required": false,
            "nullable": true
          }
        }
      },
      "expected_status": "completed",
      "expected_validation": "valid",
      "expected_records": [
        {
          "expected_validation": "valid",
          "fields": {
            "invoice_number": {
              "presence": "present",
              "value": "INV-2026-101",
              "match_mode": "exact",
              "expected_evidence": [
                "invoice_number: INV-2026-101"
              ],
              "expect_ambiguous": false
            },
            "vendor_name": {
              "presence": "present",
              "value": "Northwind Industrial Ltd.",
              "match_mode": "exact",
              "expected_evidence": [
                "vendor_name: Northwind Industrial Ltd."
              ],
              "expect_ambiguous": false
            },
            "issue_date": {
              "presence": "present",
              "value": "2026-04-01",
              "match_mode": "date_iso",
              "expected_evidence": [
                "issue_date: 2026-04-01"
              ],
              "expect_ambiguous": false
            },
            "total_amount": {
              "presence": "present",
              "value": "2450.00",
              "match_mode": "decimal_equal",
              "expected_evidence": [
                "total_amount: 2450.00"
              ],
              "expect_ambiguous": false
            },
            "currency": {
              "presence": "present",
              "value": "USD",
              "match_mode": "exact",
              "expected_evidence": [
                "currency: USD"
              ],
              "expect_ambiguous": false
            },
            "notes": {
              "presence": "missing",
              "value": null,
              "match_mode": "exact",
              "expected_evidence": [],
              "expect_ambiguous": false
            }
          }
        }
      ]
    },
