      "case_id": "cor-docx-001",
      "category": "correspondence",
      "format": "docx",
      "challenge_profiles": [
        "straightforward"
      ],
      "description": "Straightforward DOCX compliance confirmation memo.",
      "document": {
        "kind": "docx",
        "filename": "cor_001.docx",
        "lines": [
          "sender: Legal Compliance Office",
          "recipient: Operations Directorate",
          "sent_date: 2026-07-12",
          "subject: Annual Audit Confirmation",
          "priority: high"
        ]
      },
      "schema_definition": {
        "schema_id": "correspondence-schema",
        "schema_version": "1.0",
        "cardinality": "single",
        "fields": {
          "sender": {
            "type": "string",
            "required": true
          },
          "recipient": {
            "type": "string",
            "required": true
          },
          "sent_date": {
            "type": "date",
            "required": true
          },
          "subject": {
            "type": "string",
            "required": true
          },
          "priority": {
            "type": "string",
