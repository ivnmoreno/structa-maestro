              "match_mode": "exact",
              "expected_evidence": [
                "sent_date: 2026-07-12"
              ],
              "expect_ambiguous": false
            },
            "subject": {
              "presence": "present",
              "value": "Annual Audit Confirmation",
              "match_mode": "exact",
              "expected_evidence": [
                "subject: Annual Audit Confirmation"
              ],
