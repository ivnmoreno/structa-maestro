{
  "cases": [
    {
      "case_id": "ctr-pdf-001",
      "category": "contracts",
      "format": "pdf",
      "challenge_profiles": [
        "straightforward"
      ],
      "description": "Straightforward PDF services agreement.",
      "document": {
        "kind": "pdf",
        "filename": "ctr_001.pdf",
        "pages": [
          "contract_id: CTR-2026-088\nparty_a: Meridian Logistics GmbH\nparty_b: Alpine Cloud AG\neffective_date: 2026-05-01\ncontract_value: 50000.00"
        ]
      },
      "schema_definition": {
        "schema_id": "contract-schema",
        "schema_version": "1.0",
        "cardinality": "single",
        "fields": {
          "contract_id": {
            "type": "string",
            "required": true
          },
          "party_a": {
            "type": "string",
            "required": true
          },
          "party_b": {
            "type": "string",
            "required": true
          },
          "effective_date": {
            "type": "date",
            "required": true
          },
          "contract_value": {
            "type": "decimal",
            "required": false,
            "min_value": 0
          }
        }
      },
      "expected_status": "completed",
      "expected_validation": "valid",
      "expected_records": [
        {
          "expected_validation": "valid",
          "fields": {
            "contract_id": {
              "presence": "present",
              "value": "CTR-2026-088",
              "match_mode": "exact",
              "expected_evidence": [
                "contract_id: CTR-2026-088"
              ],
              "expect_ambiguous": false
            },
            "party_a": {
              "presence": "present",
              "value": "Meridian Logistics GmbH",
              "match_mode": "exact",
              "expected_evidence": [
                "party_a: Meridian Logistics GmbH"
              ],
              "expect_ambiguous": false
            },
            "party_b": {
              "presence": "present",
              "value": "Alpine Cloud AG",
              "match_mode": "exact",
              "expected_evidence": [
                "party_b: Alpine Cloud AG"
              ],
              "expect_ambiguous": false
            },
            "effective_date": {
              "presence": "present",
              "value": "2026-05-01",
              "match_mode": "exact",
              "expected_evidence": [
                "effective_date: 2026-05-01"
              ],
              "expect_ambiguous": false
            },
            "contract_value": {
              "presence": "present",
              "value": "50000.00",
              "match_mode": "decimal_equal",
              "expected_evidence": [
                "contract_value: 50000.00"
              ],
              "expect_ambiguous": false
            }
          }
        }
      ]
    },
    {
      "case_id": "ctr-docx-002",
      "category": "contracts",
      "format": "docx",
      "challenge_profiles": [
        "nested_records"
      ],
      "description": "DOCX contract with nested parties object and array of clause identifiers.",
      "document": {
        "kind": "docx",
        "filename": "ctr_002_nested.docx",
        "headings": [
          "Master Services Agreement"
        ],
        "lines": [
          "contract_id: CTR-2026-089",
          "parties.client: Orion BioLabs",
          "parties.provider: Vega Data Systems",
          "clauses: confidentiality, indemnity, sla"
        ]
      },
      "schema_definition": {
        "schema_id": "contract-nested-schema",
        "schema_version": "1.0",
        "cardinality": "single",
        "fields": {
          "contract_id": {
            "type": "string",
            "required": true
          },
          "parties": {
            "type": "object",
            "required": true,
            "properties": {
              "client": {
                "type": "string",
                "required": true
              },
              "provider": {
                "type": "string",
                "required": true
              }
            }
          },
          "clauses": {
            "type": "array",
            "required": true,
            "min_items": 1,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "expected_status": "completed",
      "expected_validation": "valid",
      "expected_records": [
        {
          "expected_validation": "valid",
          "fields": {
            "contract_id": {
              "presence": "present",
              "value": "CTR-2026-089",
              "match_mode": "exact",
              "expected_evidence": [
                "contract_id: CTR-2026-089"
              ],
              "expect_ambiguous": false
            },
            "parties": {
              "presence": "present",
              "value": {
                "client": "Orion BioLabs",
                "provider": "Vega Data Systems"
              },
              "match_mode": "exact",
              "expected_evidence": [
                "parties.client: Orion BioLabs",
                "parties.provider: Vega Data Systems"
              ],
              "expect_ambiguous": false
            },
            "clauses": {
              "presence": "present",
              "value": [
                "confidentiality",
                "indemnity",
                "sla"
              ],
              "match_mode": "exact",
              "expected_evidence": [
                "clauses: confidentiality, indemnity, sla"
              ],
              "expect_ambiguous": false
            }
          }
        }
      ]
    },
