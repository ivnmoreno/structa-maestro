    {
      "case_id": "fin-pdf-005",
      "category": "financial_documents",
      "format": "pdf",
      "challenge_profiles": [
        "nested_records"
      ],
      "description": "PDF settlement confirmation with nested settlement object.",
      "document": {
        "kind": "pdf",
        "filename": "fin_005_nested.pdf",
        "pages": [
          "account_reference: ACC-909\nsettlement.amount: 25000.00\nsettlement.currency: CHF\nsettlement.value_date: 2026-10-15"
        ]
      },
      "schema_definition": {
        "schema_id": "financial-nested",
        "schema_version": "1.0",
        "cardinality": "single",
        "fields": {
          "account_reference": {
            "type": "string",
            "required": true
          },
          "settlement": {
            "type": "object",
            "required": true,
            "properties": {
              "amount": {
                "type": "decimal",
                "required": true,
                "min_value": 0
              },
              "currency": {
                "type": "string",
                "required": true
              },
              "value_date": {
                "type": "date",
                "required": true
              }
            }
          }
        }
      },
      "expected_status": "completed",
      "expected_validation": "valid",
      "expected_records": [
        {
          "expected_validation": "valid",
          "fields": {
            "account_reference": {
              "presence": "present",
              "value": "ACC-909",
              "match_mode": "exact",
              "expected_evidence": [
                "account_reference: ACC-909"
              ],
              "expect_ambiguous": false
            },
            "settlement": {
              "presence": "present",
              "value": {
                "amount": "25000.00",
                "currency": "CHF",
                "value_date": "2026-10-15"
              },
              "match_mode": "exact",
              "expected_evidence": [
                "settlement.amount: 25000.00",
                "settlement.currency: CHF"
              ],
              "expect_ambiguous": false
            }
          }
        }
      ]
    },
