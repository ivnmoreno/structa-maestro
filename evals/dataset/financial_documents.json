{
  "cases": [
    {
      "case_id": "fin-txt-001",
      "category": "financial_documents",
      "format": "txt",
      "challenge_profiles": [
        "straightforward"
      ],
      "description": "Straightforward TXT wire confirmation preserving leading-zero account reference.",
      "document": {
        "kind": "txt",
        "filename": "fin_001.txt",
        "lines": [
          "account_reference: 00098412",
          "closing_balance: 84250.75",
          "currency: CHF",
          "statement_date: 2026-09-30",
          "verified: true"
        ]
      },
      "schema_definition": {
        "schema_id": "financial-schema",
        "schema_version": "1.0",
        "cardinality": "single",
        "fields": {
          "account_reference": {
            "type": "string",
            "required": true
          },
          "closing_balance": {
            "type": "decimal",
            "required": true
          },
          "currency": {
            "type": "string",
            "required": true,
            "allowed_values": [
              "USD",
              "EUR",
              "CHF",
              "GBP"
            ]
          },
          "statement_date": {
            "type": "date",
            "required": true
          },
          "verified": {
            "type": "boolean",
            "required": true
          }
        }
      },
      "expected_status": "completed",
      "expected_validation": "valid",
      "expected_records": [
        {
          "expected_validation": "valid",
          "fields": {
            "account_reference": {
              "presence": "present",
              "value": "00098412",
              "match_mode": "exact",
              "expected_evidence": [
                "account_reference: 00098412"
              ],
              "expect_ambiguous": false
            },
            "closing_balance": {
              "presence": "present",
              "value": "84250.75",
              "match_mode": "decimal_equal",
              "expected_evidence": [
                "closing_balance: 84250.75"
              ],
              "expect_ambiguous": false
            },
            "currency": {
              "presence": "present",
              "value": "CHF",
              "match_mode": "exact",
              "expected_evidence": [
                "currency: CHF"
              ],
              "expect_ambiguous": false
            },
            "statement_date": {
              "presence": "present",
              "value": "2026-09-30",
              "match_mode": "exact",
              "expected_evidence": [
                "statement_date: 2026-09-30"
              ],
              "expect_ambiguous": false
            },
            "verified": {
              "presence": "present",
              "value": true,
              "match_mode": "exact",
              "expected_evidence": [
                "verified: true"
              ],
              "expect_ambiguous": false
            }
          }
        }
      ]
    },
