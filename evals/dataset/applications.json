{
  "cases": [
    {
      "case_id": "app-txt-001",
      "category": "applications",
      "format": "txt",
      "challenge_profiles": [
        "straightforward"
      ],
      "description": "Straightforward fellowship application.",
      "document": {
        "kind": "txt",
        "filename": "app_001.txt",
        "lines": [
          "applicant_name: Marcus Thorne",
          "program_track: Applied AI",
          "national_id: 00491827",
          "submitted_date: 2026-03-10"
        ]
      },
      "schema_definition": {
        "schema_id": "application-schema",
        "schema_version": "1.0",
        "cardinality": "single",
        "fields": {
          "applicant_name": {
            "type": "string",
            "required": true
          },
          "program_track": {
            "type": "string",
            "required": true
          },
          "national_id": {
            "type": "string",
            "required": true
          },
          "submitted_date": {
            "type": "date",
            "required": true
          }
        }
      },
      "expected_status": "completed",
      "expected_validation": "valid",
      "expected_records": [
        {
          "expected_validation": "valid",
          "fields": {
            "applicant_name": {
              "presence": "present",
              "value": "Marcus Thorne",
              "match_mode": "exact",
              "expected_evidence": [
                "applicant_name: Marcus Thorne"
              ],
              "expect_ambiguous": false
            },
            "program_track": {
              "presence": "present",
              "value": "Applied AI",
              "match_mode": "exact",
              "expected_evidence": [
                "program_track: Applied AI"
              ],
              "expect_ambiguous": false
            },
            "national_id": {
              "presence": "present",
              "value": "00491827",
              "match_mode": "exact",
              "expected_evidence": [
                "national_id: 00491827"
              ],
              "expect_ambiguous": false
            },
            "submitted_date": {
              "presence": "present",
              "value": "2026-03-10",
              "match_mode": "exact",
              "expected_evidence": [
                "submitted_date: 2026-03-10"
              ],
              "expect_ambiguous": false
            }
          }
        }
      ]
    },
