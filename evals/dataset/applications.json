    {
      "case_id": "app-docx-003",
      "category": "applications",
      "format": "docx",
      "challenge_profiles": [
        "nested_records"
      ],
      "description": "DOCX application with nested contact object preserving leading-zero phone.",
      "document": {
        "kind": "docx",
        "filename": "app_003_nested.docx",
        "lines": [
          "applicant_name: Liam O'Connor",
          "contact.email: liam@example.test",
          "contact.phone: 0041441234567"
        ]
      },
      "schema_definition": {
        "schema_id": "application-nested-schema",
        "schema_version": "1.0",
        "cardinality": "single",
        "fields": {
          "applicant_name": {
            "type": "string",
            "required": true
          },
          "contact": {
            "type": "object",
            "required": true,
            "properties": {
              "email": {
                "type": "string",
                "required": true
              },
              "phone": {
                "type": "string",
                "required": true
              }
            }
          }
        }
      },
      "expected_status": "completed",
      "expected_validation": "valid",
      "expected_records": [
        {
          "expected_validation": "valid",
          "fields": {
            "applicant_name": {
              "presence": "present",
              "value": "Liam O'Connor",
              "match_mode": "exact",
              "expected_evidence": [
                "applicant_name: Liam O'Connor"
              ],
              "expect_ambiguous": false
            },
            "contact": {
              "presence": "present",
              "value": {
                "email": "liam@example.test",
                "phone": "0041441234567"
              },
              "match_mode": "exact",
              "expected_evidence": [
                "contact.email: liam@example.test",
                "contact.phone: 0041441234567"
              ],
              "expect_ambiguous": false
            }
          }
        }
      ]
    },
