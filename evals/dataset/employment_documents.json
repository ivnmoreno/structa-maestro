{
  "cases": [
    {
      "case_id": "emp-docx-001",
      "category": "employment_documents",
      "format": "docx",
      "challenge_profiles": [
        "straightforward"
      ],
      "description": "Straightforward DOCX employment offer letter.",
      "document": {
        "kind": "docx",
        "filename": "emp_001.docx",
        "headings": [
          "Employment Agreement"
        ],
        "lines": [
          "employee_id: EMP-0042",
          "employee_name: Elena Vance",
          "position: Senior Data Engineer",
          "employer: Helvetia Analytics",
          "start_date: 2026-06-01"
        ]
      },
      "schema_definition": {
        "schema_id": "employment-schema",
        "schema_version": "1.0",
        "cardinality": "single",
        "fields": {
          "employee_id": {
            "type": "string",
            "required": true,
            "pattern": "^EMP-\\d{4}$"
          },
          "employee_name": {
            "type": "string",
            "required": true
          },
          "position": {
            "type": "string",
            "required": true
          },
          "employer": {
            "type": "string",
            "required": true
          },
          "start_date": {
            "type": "date",
            "required": true
          },
          "bonus_target": {
            "type": "decimal",
            "required": false,
            "min_value": 0
          }
        }
      },
      "expected_status": "completed",
      "expected_validation": "valid",
      "expected_records": [
        {
          "expected_validation": "valid",
          "fields": {
            "employee_id": {
              "presence": "present",
              "value": "EMP-0042",
              "match_mode": "exact",
              "expected_evidence": [
                "employee_id: EMP-0042"
              ],
              "expect_ambiguous": false
            },
            "employee_name": {
              "presence": "present",
              "value": "Elena Vance",
              "match_mode": "exact",
              "expected_evidence": [
                "employee_name: Elena Vance"
              ],
              "expect_ambiguous": false
            },
            "position": {
              "presence": "present",
              "value": "Senior Data Engineer",
              "match_mode": "exact",
              "expected_evidence": [
                "position: Senior Data Engineer"
              ],
              "expect_ambiguous": false
            },
            "employer": {
              "presence": "present",
              "value": "Helvetia Analytics",
              "match_mode": "exact",
              "expected_evidence": [
                "employer: Helvetia Analytics"
              ],
              "expect_ambiguous": false
            },
            "start_date": {
              "presence": "present",
              "value": "2026-06-01",
              "match_mode": "exact",
              "expected_evidence": [
                "start_date: 2026-06-01"
              ],
              "expect_ambiguous": false
            },
            "bonus_target": {
              "presence": "missing",
              "value": null,
              "match_mode": "exact",
              "expected_evidence": [],
              "expect_ambiguous": false
            }
          }
        }
      ]
    },
