    {
      "case_id": "emp-docx-004",
      "category": "employment_documents",
      "format": "docx",
      "challenge_profiles": [
        "nested_records"
      ],
      "description": "DOCX compensation package with nested compensation object and skills array.",
      "document": {
        "kind": "docx",
        "filename": "emp_004_nested.docx",
        "lines": [
          "employee_name: Sofia Rossi",
          "compensation.base_salary: 115000.00",
          "compensation.currency: EUR",
          "skills: python, sql, validation"
        ]
      },
      "schema_definition": {
        "schema_id": "employment-nested-schema",
        "schema_version": "1.0",
        "cardinality": "single",
        "fields": {
          "employee_name": {
            "type": "string",
            "required": true
          },
          "compensation": {
            "type": "object",
            "required": true,
            "properties": {
              "base_salary": {
                "type": "decimal",
                "required": true,
                "min_value": 0
              },
              "currency": {
                "type": "string",
                "required": true
              }
            }
          },
          "skills": {
            "type": "array",
            "required": true,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "expected_status": "completed",
      "expected_validation": "valid",
      "expected_records": [
        {
          "expected_validation": "valid",
          "fields": {
            "employee_name": {
              "presence": "present",
              "value": "Sofia Rossi",
              "match_mode": "exact",
              "expected_evidence": [
                "employee_name: Sofia Rossi"
              ],
              "expect_ambiguous": false
            },
            "compensation": {
              "presence": "present",
              "value": {
                "base_salary": "115000.00",
                "currency": "EUR"
              },
              "match_mode": "exact",
              "expected_evidence": [
                "compensation.base_salary: 115000.00",
                "compensation.currency: EUR"
              ],
              "expect_ambiguous": false
            },
            "skills": {
              "presence": "present",
              "value": [
                "python",
                "sql",
                "validation"
              ],
              "match_mode": "exact",
              "expected_evidence": [
                "skills: python, sql, validation"
              ],
              "expect_ambiguous": false
            }
          }
        }
      ]
    },
