      "case_id": "inv-txt-001",
      "category": "invoices",
      "format": "txt",
      "content_lines": [
        "Invoice Number: INV-2026-101",
        "Vendor: Northwind Industrial Ltd.",
        "Issue Date: 2026-04-01",
        "Total Amount: 2450.00",
        "Currency: USD"
      ],
      "schema": {
        "schema_id": "invoice-schema",
        "schema_version": "1.0",
        "cardinality": "single",
        "fields": {
          "invoice_number": {"type": "string", "required": true},
          "vendor_name": {"type": "string", "required": true},
          "issue_date": {"type": "date", "required": true},
          "total_amount": {"type": "decimal", "required": true, "min_value": 0},
          "currency": {"type": "string", "required": true, "allowed_values": ["USD", "EUR", "GBP"]},
          "notes": {"type": "string", "required": false}
        }
      },
      "expected_status": "completed",
      "expected_validation": "valid",
      "expected_records": [
        {
          "fields": {
            "invoice_number": {"presence": "present", "value": "INV-2026-101", "evidence": "Invoice Number: INV-2026-101"},
            "vendor_name": {"presence": "present", "value": "Northwind Industrial Ltd.", "evidence": "Vendor: Northwind Industrial Ltd."},
            "issue_date": {"presence": "present", "value": "2026-04-01", "evidence": "Issue Date: 2026-04-01"},
            "total_amount": {"presence": "present", "value": "2450.00", "evidence": "Total Amount: 2450.00"},
            "currency": {"presence": "present", "value": "USD", "evidence": "Currency: USD"},
            "notes": {"presence": "missing", "value": null}
          }
        }
      ]
    },
